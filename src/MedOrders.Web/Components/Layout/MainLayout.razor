@inherits LayoutComponentBase

<header class="topbar">
    <a class="brand" href="/">
        <span class="brand-mark">+</span>
        <span>МедЗаказ</span>
    </a>
    <form class="search" method="get" action="/">
        <input type="search" name="search" placeholder="Поиск по названию или артикулу" />
        <button class="search-btn" type="submit" aria-label="Найти">🔍</button>
    </form>
    <AuthorizeView>
        <Authorized>
            <div class="user-block">
                @if (context.User.IsInRole(RoleNames.Manager))
                {
                    <a class="link" href="/manager/products/new">Добавить товар</a>
                }
                <span class="user">@context.User.GetFullName() · @context.User.GetRoleName()</span>
                <form method="post" action="/account/logout" class="logout">
                    <AntiforgeryToken />
                    <button class="link" type="submit">Выйти</button>
                </form>
            </div>
        </Authorized>
        <NotAuthorized>
            <a class="user" href="/account/login">Войти</a>
        </NotAuthorized>
    </AuthorizeView>
</header>

<main class="page">
    @Body
</main>

