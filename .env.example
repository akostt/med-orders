# Скопируйте в .env. Файл .env не коммитится (см. .gitignore).

# Пароль SA для SQL Server. Должен совпадать с паролем, с которым создан контейнер.
# Требования SQL Server: не менее 8 символов, заглавные и строчные буквы, цифры, спецсимвол.
MSSQL_SA_PASSWORD=<ЗАМЕНИТЕ_НА_ПАРОЛЬ_SA>

# Учётные записи задаются миграцией (Data/SeedAccounts.cs), отдельных переменных не нужно.
